{
  "name": "be-the-borrow-checker",
  "version": "0.1.0",
  "private": true,
  "description": "A Rust quiz where you play the compiler. Every answer is checked by rustc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reinhash/be-the-borrow-checker.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=warning && node node_modules/.cache/verify.mjs",
    "test": "esbuild test/check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check.mjs --log-level=warning && node node_modules/.cache/check.mjs",
    "build": "npm run verify && npm test && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
